/* ============================================
   风哨 QSS 主题1：暗夜科技（当前默认，已优化）
   ============================================ */

QMainWindow { background-color: #1a1b1e; }
QGroupBox {
    font-weight: bold; border: 1px solid #2d2d30;
    border-radius: 8px; margin-top: 12px; padding-top: 18px;
    color: #cccccc; background-color: #1e1f22;
}
QGroupBox::title {
    subcontrol-origin: margin; left: 14px; padding: 0 8px;
    color: #e0e0e0; font-size: 13px;
}
QTreeWidget {
    background-color: #1e1f22; color: #d4d4d4;
    border: 1px solid #2d2d30; border-radius: 6px;
    alternate-background-color: #222326;
}
QTreeWidget::item:hover { background-color: #2a2d32; }
QTreeWidget::item:selected { background-color: #264f78; }
QPushButton {
    padding: 6px 18px; border-radius: 5px;
    background-color: #2d2d30; color: #d4d4d4;
    border: 1px solid #3e3e42; font-size: 12px;
}
QPushButton:hover { background-color: #3e3e42; }
QPushButton:pressed { background-color: #1a1b1e; }
QPushButton:disabled { background-color: #222; color: #666; }
QTabWidget::pane { border: 1px solid #2d2d30; background-color: #1e1f22; }
QTabBar::tab {
    background-color: #25262a; color: #999; padding: 8px 22px;
    border: 1px solid #2d2d30; border-bottom: none; border-radius: 4px 4px 0 0;
    margin-right: 2px; font-size: 13px;
}
QTabBar::tab:selected { background-color: #1e1f22; color: #ffffff; }
QTabBar::tab:hover { color: #cccccc; }
QLineEdit, QSpinBox, QComboBox {
    background-color: #2b2d30; color: #d4d4d4;
    border: 1px solid #3e3e42; border-radius: 4px; padding: 5px 10px;
}
QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    background-color: #2b2d30; color: #d4d4d4;
    selection-background-color: #264f78;
}
QCheckBox { color: #cccccc; spacing: 6px; }
QCheckBox::indicator {
    width: 16px; height: 16px; border: 2px solid #555; border-radius: 3px;
}
QCheckBox::indicator:checked { background-color: #0e639c; border-color: #0e639c; }
QDateEdit {
    background-color: #2b2d30; color: #d4d4d4;
    border: 1px solid #3e3e42; border-radius: 4px; padding: 4px 8px;
}
QDateEdit::drop-down { background-color: #2d2d30; border: none; }
QCalendarWidget { background-color: #2b2d30; color: #d4d4d4; }
QProgressBar {
    border: 1px solid #3e3e42; border-radius: 4px;
    background-color: #1e1f22; text-align: center; color: #ccc;
    height: 18px;
}
QProgressBar::chunk { background-color: #0e639c; border-radius: 3px; }
QLabel { color: #cccccc; }
QStatusBar { background-color: #25262a; color: #888; }
QSlider::groove:horizontal {
    border: 1px solid #3e3e42; height: 6px; background: #2b2d30;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #0e639c; width: 16px; height: 16px;
    margin: -6px 0; border-radius: 8px;
}
QScrollBar:vertical { background: #1e1f22; width: 10px; }
QScrollBar::handle:vertical { background: #3e3e42; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #1e1f22; height: 10px; }
QScrollBar::handle:horizontal { background: #3e3e42; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
