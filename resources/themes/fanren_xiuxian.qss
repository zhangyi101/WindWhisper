/* ============================================
   风语 QSS 主题4：凡人修仙传
   中灰底 + 深翠绿 — 掌天瓶
   ============================================ */

QMainWindow { background-color: #c8d0c8; }
QGroupBox {
    font-weight: bold; border: 1px solid #b0b8b0;
    border-radius: 6px; margin-top: 12px; padding-top: 18px;
    color: #2a3a2a; background-color: #dce2dc;
}
QGroupBox::title {
    subcontrol-origin: margin; left: 14px; padding: 0 8px;
    color: #3a6a3a; font-size: 14px;
}
QTreeWidget {
    background-color: #f0f4f0; color: #2a3a2a;
    border: 1px solid #b0b8b0; border-radius: 4px;
    alternate-background-color: #e8ece8;
}
QTreeWidget::item:hover { background-color: #d8e0d8; }
QTreeWidget::item:selected { background-color: #a8c8a8; color: #1a2a1a; }
QPushButton {
    padding: 7px 20px; border-radius: 4px;
    background-color: #d8e0d8; color: #2a3a2a;
    border: 1px solid #a8b8a8; font-size: 13px;
}
QPushButton:hover { background-color: #c8d8c8; border-color: #4a8a4a; }
QPushButton:pressed { background-color: #b0c8b0; }
QPushButton:disabled { background-color: #e0e8e0; color: #8a9a8a; }
QTabWidget::pane { border: 1px solid #b0b8b0; background-color: #f0f4f0; }
QTabBar::tab {
    background-color: #d8e0d8; color: #5a7a5a; padding: 8px 22px;
    border: 1px solid #b0b8b0; border-bottom: none; border-radius: 4px 4px 0 0;
    margin-right: 2px; font-size: 13px;
}
QTabBar::tab:selected { background-color: #f0f4f0; color: #3a6a3a; }
QTabBar::tab:hover { color: #4a8a4a; }
QLineEdit, QSpinBox, QComboBox {
    background-color: #ffffff; color: #2a3a2a;
    border: 1px solid #a8b8a8; border-radius: 4px; padding: 5px 10px;
}
QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    background-color: #ffffff; color: #2a3a2a;
    selection-background-color: #a8c8a8;
}
QCheckBox { color: #2a3a2a; spacing: 6px; }
QCheckBox::indicator {
    width: 16px; height: 16px; border: 2px solid #8aaa8a; border-radius: 3px;
}
QCheckBox::indicator:checked { background-color: #3a6a3a; border-color: #3a6a3a; }
QDateEdit {
    background-color: #ffffff; color: #2a3a2a;
    border: 1px solid #a8b8a8; border-radius: 4px; padding: 4px 8px;
}
QCalendarWidget { background-color: #ffffff; color: #2a3a2a; }
QProgressBar {
    border: 1px solid #b0b8b0; border-radius: 4px;
    background-color: #e0e8e0; text-align: center; color: #2a3a2a; height: 18px;
}
QProgressBar::chunk { background-color: #3a6a3a; border-radius: 3px; }
QLabel { color: #2a3a2a; }
QStatusBar { background-color: #c8d0c8; color: #6a8a6a; }
QScrollBar:vertical { background: #e0e8e0; width: 10px; }
QScrollBar::handle:vertical { background: #a8b8a8; border-radius: 3px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #e0e8e0; height: 10px; }
QScrollBar::handle:horizontal { background: #a8b8a8; border-radius: 3px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
